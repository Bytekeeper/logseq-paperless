{
  "name": "logseq-plugin-paperless",
  "version": "0.1.0",
  "description": "Insert links to paperless-ngx saved views and documents from Logseq.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "logseq": {
    "id": "logseq-plugin-paperless",
    "title": "Paperless-ngx Links",
    "icon": "./logo.svg",
    "main": "dist/index.html"
  },
  "dependencies": {
    "@logseq/libs": "^0.0.17"
  },
  "resolutions": {
    "dompurify": "^3.4.13",
    "lodash-es": "^4.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.4",
    "vite-plugin-logseq": "^1.1.2",
    "vitest": "^4.1.10"
  }
}
